<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/quicknote_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/quicknote_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Icon -->
        <ImageView
            android:id="@+id/imageViewNoteIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_note"
            app:layout_constraintBottom_toBottomOf="@id/textViewNoteTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textViewNoteTitle"
            app:tint="@color/quicknote_green" />

        <!-- Title -->
        <TextView
            android:id="@+id/textViewNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/quicknote_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/textViewNoteDate"
            app:layout_constraintStart_toEndOf="@id/imageViewNoteIcon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Título da nota" />

        <!-- Short Date -->
        <TextView
            android:id="@+id/textViewNoteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/quicknote_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/textViewNoteTitle"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="12/09/2026" />

        <!-- Content Preview -->
        <TextView
            android:id="@+id/textViewNoteContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/quicknote_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textViewNoteTitle"
            app:layout_constraintTop_toBottomOf="@id/textViewNoteTitle"
            tools:text="Conteúdo resumido da nota..." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>