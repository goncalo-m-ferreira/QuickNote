<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quicknote_background"
    android:fillViewport="true"
    tools:context=".AccountActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <!-- Header: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/back_button_desc"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/quicknote_text_primary" />

            <TextView
                android:id="@+id/textViewAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/account_title"
                android:textColor="@color/quicknote_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Card: Perfil -->
        <LinearLayout
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_about_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_section_title"
                android:textColor="@color/quicknote_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Field: Nome de apresentação -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/display_name_label"
                android:textColor="@color/quicknote_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_auth_input"
                android:hint="@string/display_name_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLength="20"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/quicknote_text_primary"
                android:textColorHint="@color/quicknote_text_secondary"
                android:textSize="15sp" />

            <!-- Field: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/email_field_label"
                android:textColor="@color/quicknote_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/quicknote_text_secondary"
                android:textSize="15sp"
                tools:text="utilizador@exemplo.com" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="@string/save_changes_button"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/quicknote_green_action"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
